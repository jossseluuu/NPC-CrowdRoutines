// Map generator templates. Add your own entry here to get a new procedural city style without touching C++.
//
// layout:   spacing [x, y] metres between intersections, jitter (fraction of spacing), warp (metres of smooth
//           noise displacement), avenue_every (every N-th row/column is an avenue), diagonal (add a diagonal avenue),
//           remove (probability of removing a street segment; connectivity is preserved), path_ratio (fraction of
//           removed segments that stay as pedestrian paths).
// water:    { "type": "none" | "river" | "coast", "width": metres, "amplitude": metres, "bridge_every": columns }
// zoning:   ordered rules, first match wins. Coordinates are normalised (0..1, origin top-left).
//           { "district": id, "circle": [cx, cy, r] } | { "band": "coast"|"river", "width": metres }
//           | { "rect": [x0, y0, x1, y1] } | { "default": { district: weight, ... } }
//           "chance" (0..1) makes a rule apply only to that fraction of blocks (adds variety).
// sizes:    world size per size id; population suggests a default resident count.
{
  "format": "npc-map-templates",
  "version": 1,
  "sizes": {
    "small":  { "width": 900,  "height": 650,  "population": 2500 },
    "medium": { "width": 1600, "height": 1150, "population": 8000 },
    "large":  { "width": 2600, "height": 1800, "population": 20000 }
  },
  "templates": [
